{
  "name": "@lage-run/docs",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "tsc && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve"
  },
  "devDependencies": {
    "@cmfcmf/docusaurus-search-local": "^1.2.0",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.1.0",
    "@tailwindcss/postcss": "^4.0.17",
    "@tsconfig/docusaurus": "^2.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.0.1",
    "react-dom": "^18.0.1",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.0.0"
  },
  "resolutions": {
    "@docsearch/react/@algolia/autocomplete-core@npm:1.19.2": "1.19.12",
    "@cmfcmf/docusaurus-search-local@npm:1.2.0/cheerio": "1.0.0-rc.12",
    "@docusaurus/core/tinypool": "2.2.0",
    "@types/node@npm:*": "^24.0.0",
    "@types/react@npm:*": "^18.0.0",
    "lodash-es@npm:4.17.23": "^4.18.1",
    "node-gyp": "ignore:",
    "serve-handler/minimatch@npm:3.1.2": "^3.1.5",
    "webpack@npm:^5.88.1": "~5.105.0",
    "webpack@npm:^5.95.0": "~5.105.0"
  },
  "rationale": {
    "devDependencies": {
      "@cmfcmf/docusaurus-search-local": "implicit peer of docusaurus?"
    },
    "resolutions": {
      "@docsearch/react/@algolia/autocomplete-core@npm:1.19.2": "Pin to version matching other packages",
      "@cmfcmf/docusaurus-search-local@npm:1.2.0/cheerio": "docusaurus depends on a specific file path that was removed after this version",
      "@docusaurus/core/tinypool": "Update for security fixes (dep is not actually used since SSG worker threads are not enabled for this site)",
      "lodash-es@npm:4.17.23": "Unpin to fix security issue",
      "serve-handler/minimatch@npm:3.1.2": "unpin to fix security issue",
      "webpack@npm:^5": "webpack 5.106 added strict schema validation to ProgressPlugin that breaks webpackbar (used by @docusaurus/bundler); pin below 5.106 until webpackbar releases a fix"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "overrides": [
      {
        "files": [
          "*.md",
          "*.mdx"
        ],
        "options": {
          "printWidth": 80,
          "trailingComma": "none"
        }
      }
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
